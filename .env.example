# Copy to .env and fill in. .env is git-ignored.
# A variable set in the shell wins over .env, e.g. `PLATFORM=ios npx wdio run wdio.conf.ts`.

STANDARD_USER=
STANDARD_USER_PASSWORD=

# Where and on what to run
RUN_TARGET=local # local | browserstack
PLATFORM=android # android | ios

# Local Appium. The udid is optional on Android with a single device, required on iOS.
APPIUM_DEVICE_ID=
ANDROID_APP_PATH= # .apk, absolute or relative to the project root
IOS_APP_PATH= # .app for a simulator, .ipa for a real device

# BrowserStack
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
ANDROID_BS_APP= # bs://... id of the uploaded build
IOS_BS_APP=
# Optional device per platform, defaults: Samsung Galaxy S23 / 13.0 and iPhone SE 2022 / 15
ANDROID_BS_DEVICE_NAME=
ANDROID_BS_PLATFORM_VERSION=
IOS_BS_DEVICE_NAME=
IOS_BS_PLATFORM_VERSION=
BS_BUILD_NAME=
